{
  "aptPackages": [
    "bash-completion",
    "bat",
    "btop",
    "chafa",
    "clang-tidy",
    "du-dust",
    "eza",
    "fzf",
    "golang-go",
    "lazygit",
    "libicu78",
    "zoxide",
    "zsh"
  ],
  "files": [
    {
      "from": "install-editor.sh",
      "to": "/opt/agents-in-the-cloud/install-nox-editor.sh"
    },
    {
      "from": "nvim",
      "to": "/opt/agents-in-the-cloud/nox-editor/config"
    },
    {
      "from": "nvim-plugins.json",
      "to": "/opt/agents-in-the-cloud/nox-editor/plugins.json"
    },
    {
      "from": "build-editor.sh",
      "to": "/opt/agents-in-the-cloud/nox-editor/build.sh"
    },
    {
      "from": "build-editor.lua",
      "to": "/opt/agents-in-the-cloud/nox-editor/build.lua"
    },
    {
      "from": "nvim-launch.sh",
      "to": "/opt/agents-in-the-cloud/nox-editor/nvim",
      "mode": "0755"
    },
    {
      "from": "nvim",
      "to": "/opt/agents-in-the-cloud/home-defaults/.config/nvim",
      "afterRun": true
    },
    {
      "from": "home-defaults/.bashrc",
      "to": "/opt/agents-in-the-cloud/home-defaults/.bashrc",
      "afterRun": true
    },
    {
      "from": "home-defaults/.config/nox-shell/bashrc",
      "to": "/opt/agents-in-the-cloud/home-defaults/.config/nox-shell/bashrc",
      "afterRun": true
    },
    {
      "from": "home-defaults/.config/nox-shell-colors.zsh",
      "to": "/opt/agents-in-the-cloud/home-defaults/.config/nox-shell-colors.zsh",
      "afterRun": true
    },
    {
      "from": "home-defaults/.zoxide_fzf_dir",
      "to": "/opt/agents-in-the-cloud/home-defaults/.zoxide_fzf_dir",
      "afterRun": true
    },
    {
      "from": "home-defaults/.pi",
      "to": "/opt/agents-in-the-cloud/home-defaults/.pi",
      "afterRun": true
    }
  ],
  "run": [
    "bash /opt/agents-in-the-cloud/install-nox-editor.sh",
    "bash /opt/agents-in-the-cloud/nox-editor/build.sh",
    "ln -sf /opt/agents-in-the-cloud/nox-editor/nvim /usr/local/bin/nvim",
    "ln -s /usr/bin/batcat /usr/local/bin/bat",
    "usermod --shell /bin/bash agents-in-the-cloud",
    "nvim --version; fzf --version; bash --version"
  ]
}
